[Unit]
Description=KDE Window Manager (Login Manager Version)
PartOf=graphical-session.target

[Service]
Environment="KWIN_USE_OVERLAYS=0"
ExecStart=/usr/bin/kwin_wayland --no-lockscreen --no-global-shortcuts --no-kactivities --inputmethod plasma-keyboard --locale1
SuccessExitStatus=15
BusName=org.kde.KWin
Slice=session.slice

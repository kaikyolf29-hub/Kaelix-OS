   <action id="org.kde.plasmasetup.createflagfile" >
      <description xml:lang="ar">أنشئ ملف علامة الإكمال</description>
      <description xml:lang="ca">Crea un fitxer d'indicadors de compleció</description>
      <description xml:lang="cs">Vytvořit soubor s doplňovacími přepínači</description>
      <description xml:lang="de">Datei als Nachweis der Fertigstellung erstellen</description>
      <description xml:lang="el">Δημιουργία αρχείου σήμανσης ολοκλήρωσης</description>
      <description>Create Completion Flag File</description>
      <description xml:lang="es">Crear archivo indicador de compleción</description>
      <description xml:lang="eu">Sortu osatu dela adierazteko fitxategia</description>
      <description xml:lang="fi">Kirjoita valmistumismerkkitiedosto</description>
      <description xml:lang="fr">Créer un fichier d'indicateurs d'achèvement</description>
      <description xml:lang="he">יצירת קובץ דגלון השלמה</description>
      <description xml:lang="hu">Befejezési jelzőfájl létrehozása</description>
      <description xml:lang="ia">Crea File de bandiera (flag) de completion</description>
      <description xml:lang="it">Crea il file di flag di completamento</description>
      <description xml:lang="ka">დასრულების ალმის ფაილის შექმნა</description>
      <description xml:lang="ko">완료 플래그 파일 생성</description>
      <description xml:lang="lt">Sukurti užbaigimo vėliavėlės failą</description>
      <description xml:lang="lv">Izveidot pabeigšanas karodziņa datni</description>
      <description xml:lang="nb">Lag en fil som bevis på fullføring</description>
      <description xml:lang="nl">Vlagbestand van voltooiing aanmaken</description>
      <description xml:lang="nn">Lag filer som indikerer fullføring</description>
      <description xml:lang="pa">ਪੂਰਨ ਹੋਣ ਦੇ ਚਿੰਨ੍ਹ ਵਾਲੀ ਫ਼ਾਇਲ ਬਣਾਓ</description>
      <description xml:lang="pl">Utwórz plik flagowy uzupełnień</description>
      <description xml:lang="pt_BR">Criar arquivo de marcador de completude</description>
      <description xml:lang="ro">Creează fișier cu fanionul de completare</description>
      <description xml:lang="ru">Создание файла-метки завершения</description>
      <description xml:lang="sk">Vytvoriť súbor príznaku dokončenia</description>
      <description xml:lang="sl">Ustvari datoteko z zastavicami za dokončanje</description>
      <description xml:lang="sr">Направи фајл ознаке завршетка</description>
      <description xml:lang="sv">Skapa fil för markering av slutfört</description>
      <description xml:lang="tr">Tamamlanma Bayrağı Dosyası Oluştur</description>
      <description xml:lang="uk">Створити файл прапорця завершення</description>
      <description xml:lang="zh_CN">创建补全标志文件</description>
      <description xml:lang="zh_TW">建立完成旗標檔案</description>
      <message xml:lang="ar">اكتب علامة /etc/plasma-setup-done لمنع إعادة تشغيل الإعداد</message>
      <message xml:lang="ca">Escriu el marcador /etc/plasma-setup-done per a evitar tornar a executar la configuració</message>
      <message xml:lang="cs">Zapsat značku /etc/plasma-setup-done pro prevenci nového spuštění úvodního nastavení</message>
      <message xml:lang="de"></message>
      <message>Write the /etc/plasma-setup-done marker to prevent rerunning setup</message>
      <message xml:lang="es">Escribir el marcador /etc/plasma-setup-done para no repetir la configuración</message>
      <message xml:lang="eu">Idatzi /etc/plasma-setup-done marka ezarpena berriz exekutatzea saihesteko</message>
      <message xml:lang="fi"></message>
      <message xml:lang="fr">Écrivez le marqueur « /etc/plasma-setup-done » pour éviter une nouvelle application de la configuration</message>
      <message xml:lang="he">לכתוב את הסמן ‎/etc/plasma-setup-done כדי למנוע את הרצת תוכנית ההתקנה שוב</message>
      <message xml:lang="hu">Létrehozza az /etc/plasma-setup-done jelölőt a beállítás újra futtatásának megelőzésére</message>
      <message xml:lang="ia">Scribe le marcator de /etc/plasma-setup-done perprevenir re-executar setup (le configurar)</message>
      <message xml:lang="it">Scrivi il marcatore /etc/plasma-setup-done per evitare di eseguire nuovamente l'installazione</message>
      <message xml:lang="ka">/etc/plasma-setup-dome ფაილის ჩაწერა მორგების პროგრამის თავიდან გაშვების თავიდან ასაცილებლად</message>
      <message xml:lang="ko">/etc/plasma-setup-done 마커를 생성하여 설정이 다시 실행되는 것을 방지함</message>
      <message xml:lang="lt"></message>
      <message xml:lang="lv"></message>
      <message xml:lang="nb">Skriv «/etc/plasma-setup-done»-markøren for å hindre at oppsettet gjentas</message>
      <message xml:lang="nl">Schrijf de /etc/plasma-setup-done markering om opzet opnieuw uit te voeren te voorkomen</message>
      <message xml:lang="nn">Lagra fila /etc/plasma-setup-done for å hindra at vegvisaren vert køyrd på nytt</message>
      <message xml:lang="pa">ਸੈਟਅੱਪ ਦੇ ਦੁਬਾਰਾ ਚਲਾਉਣ ਤੋਂ ਰੋਕਣ ਵਾਸਤੇ  /etc/plasma-setup-done ਨਿਸ਼ਾਨ ਬਣਾਓ</message>
      <message xml:lang="pl">Zapisz znacznik w /etc/plasma-setup-done aby uniemożliwić ponowne otwieranie ustawień</message>
      <message xml:lang="pt_BR">Escreve o marcador /etc/plasma-setup-done para prevenir a reexecução da configuração</message>
      <message xml:lang="ro">Scrie marcatorul /etc/plasma-setup-done pentru a preveni repetarea configurării</message>
      <message xml:lang="ru"></message>
      <message xml:lang="sk">Zapísať značku /etc/plasma-setup-done na zabránenie opätovného spustenia nastavenia</message>
      <message xml:lang="sl"></message>
      <message xml:lang="sr">Упиши маркер /etc/plasma-setup-done да се подешавање Плазме не би поново покретало</message>
      <message xml:lang="sv">Skriv markören /etc/plasma-setup-done för att förhindra att inställning utförs igen</message>
      <message xml:lang="tr">Kurulumu yeniden çalıştırmayı önlemek için /etc/plasma-setup-done imleyicisini yazın</message>
      <message xml:lang="uk">Записати позначку /etc/plasma-setup-done для запобігання повторному запуску налаштовування</message>
      <message xml:lang="zh_CN">写入 /etc/plasma-setup-done 标志以防止反复运行初始设置向导</message>
      <message xml:lang="zh_TW">寫入 /etc/plasma-setup-done 檔案來標記設定已完成，以避免重複執行初始設定</message>
      <defaults>
         <allow_inactive>no</allow_inactive>
         <allow_active>no</allow_active>
      </defaults>
   </action>
   <action id="org.kde.plasmasetup.createnewuserautostarthook" >
      <description xml:lang="ar">إنشاء خطاف بدء آلي لمستخدم جديد</description>
      <description xml:lang="az">Yeni istifadəçi avtobaşlatma qoşması yaradın</description>
      <description xml:lang="ca">Ganxo d'inici automàtic de creació d'usuari nou</description>
      <description xml:lang="cs">Vytvořit háček pro automatické spuštění nového uživatele</description>

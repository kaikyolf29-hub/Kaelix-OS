      <description xml:lang="sv">Skapa automatisk startinkoppling för ny användare</description>
      <description xml:lang="tr">Yeni Kullanıcı Kendiliğinden Başlatma Kancası Oluştur</description>
      <description xml:lang="uk">Скрипт автозапуску для нового користувача</description>
      <description xml:lang="zh_CN">创建新用户自动启动钩子</description>
      <description xml:lang="zh_TW">建立新使用者自動啟動掛鉤</description>
      <message xml:lang="ar">إنشاء خطاف بدء آلي للمستخدم المنشأ حديثًا</message>
      <message xml:lang="az">Yeni istifadəçi üçün avtobaşlatma qoşması yaratmaq</message>
      <message xml:lang="ca">Crea un ganxo d'inici automàtic per al nou usuari creat</message>
      <message xml:lang="cs">Vytvořit háček pro automatické spuštění nově vytvořeného uživatele</message>
      <message xml:lang="de">Einen Autostart-Hook für den neuen Benutzer erstellen</message>
      <message xml:lang="el">Δημιουργία μηχανισμού αυτόματης εκκίνησης για τον νέο χρήστη</message>
      <message>Create an autostart hook for the newly created user</message>
      <message xml:lang="es">Crear un gancho de inicio automático para el usuario recién creado</message>
      <message xml:lang="eu">Sortu berriki sortutako erabiltzailearentzako abio automatikorako kako bat</message>
      <message xml:lang="fi">Luo vasta luodulle käyttäjälle automaattikäynnistyskoukku</message>
      <message xml:lang="fr">Créer un script final pour démarrage automatique de l'utilisateur nouvellement créé</message>
      <message xml:lang="he">יצירת התליית התחלה אוטומטית למשתמש החדש שנוצר</message>
      <message xml:lang="hu">Létrehoz egy automatikus indítási beavatkozási pontot az újonnan létrehozott felhasználónak</message>
      <message xml:lang="ia">Crea un puncto de ancorage (hook) de startar automatic per le usator create recentemente</message>
      <message xml:lang="it">Crea un hook di avvio automatico per l'utente appena creato</message>
      <message xml:lang="ka">ავტოგაშვების კაუჭის შექმნა ახლად შექმნილი მომხმარებლისთვის</message>
      <message xml:lang="ko">새로 생성된 사용자의 자동 시작 후크 생성</message>
      <message xml:lang="lt">Sukurti naujai sukurtam naudotojui automatinio paleidimo gaudyklę</message>
      <message xml:lang="lv">Izveidot automātiskās palaišanas āķi no jauna izveidotam lietotājam</message>
      <message xml:lang="nb">Lag en autostart-krok for den nylig opprettede brukeren</message>
      <message xml:lang="nl">Een autostart-hook voor de nieuw aangemaakte gebruiker aanmaken</message>
      <message xml:lang="nn">Legg til ein autostart-krok for den nye brukaren</message>
      <message xml:lang="pa">ਨਵੇਂ ਬਣਾਏ ਵਰਤੋਂਕਾਰ ਲਈ ਆਟੋ-ਸਟਾਰਟ ਹੁਕ ਬਣਾਓ</message>
      <message xml:lang="pl">Utwórz nowy haczyk wykonywany na starcie dla nowo utworzonego użytkownika</message>
      <message xml:lang="pt_BR">Criar um gancho de inicialização automática para o usuário recém-criado</message>
      <message xml:lang="ro">Creează un cârlig de pornire automată pentru utilizatorul proaspăt creat</message>
      <message xml:lang="ru">Создание обработчика автозапуска для только что созданного пользователя</message>
      <message xml:lang="sk">Vytvoriť háčik automatického spustenia pre novo vytvoreného používateľa</message>
      <message xml:lang="sl">Ustvari kavelj za samodejni zagon za novo ustvarjenega uporabnika</message>
      <message xml:lang="sr">Направи куку самопокретања за новонаправљеног корисника</message>
      <message xml:lang="sv">Skapa en automatisk startinkoppling för den nyskapade användaren</message>
      <message xml:lang="tr">Yeni oluşturulan kullanıcı için bir kendiliğinden başlatma kancası oluşturun</message>
      <message xml:lang="uk">Створити скрипт автозапуску для новоствореного користувача</message>
      <message xml:lang="zh_CN">为新创建的用户创建一个自动启动钩子</message>
      <message xml:lang="zh_TW">為新建立的使用者建立自動啟動掛鉤</message>
      <defaults>
         <allow_inactive>no</allow_inactive>
         <allow_active>no</allow_active>
      </defaults>
   </action>

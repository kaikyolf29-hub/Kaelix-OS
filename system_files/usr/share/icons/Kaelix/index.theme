[Icon Theme]
Name=Kaelix
Comment=Ícones do Kaelix OS, tema escuro
Inherits=breeze-dark,hicolor
Example=system-file-manager
FollowsColorScheme=true
Directories=apps/scalable,status/symbolic

[apps/scalable]
Size=48
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[status/symbolic]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Status

[Icon Theme]
Name=Matsu-claro
Comment=Ícones do Matsu OS, tema claro
Inherits=breeze,hicolor
Example=system-file-manager
FollowsColorScheme=true
Directories=apps/scalable,status/symbolic

[apps/scalable]
Size=48
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[status/symbolic]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Status

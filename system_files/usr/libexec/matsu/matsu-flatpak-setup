#!/usr/bin/bash
# Liga o Flathub e instala os apps Flatpak que já vêm com o Matsu OS.
# Roda a cada boot, mas só faz algo quando a lista de apps mudou.
set -uo pipefail

LIST=/usr/share/matsu/flatpaks.txt
STAMP=/var/lib/matsu/flatpaks.sha256
MATSU_REPO=/usr/share/matsu/loja/matsu.flatpakrepo

# O repositório da Loja do Matsu (apps publicados pelo Matsu, assinados com a chave
# da Loja, que vem dentro do arquivo). Não precisa de internet para ligar; a chave
# é posta de novo a cada boot, então uma chave nova chega junto com o sistema.
if flatpak remotes --system --columns=name | grep -qx matsu; then
  flatpak remote-modify --system --gpg-import=<(sed -n 's/^GPGKey=//p' "$MATSU_REPO" | base64 -d) matsu \
    || echo "aviso: não deu para conferir a chave da Loja do Matsu" >&2
else
  flatpak remote-add --system --if-not-exists matsu "$MATSU_REPO" \
    || echo "aviso: não deu para ligar o repositório da Loja do Matsu" >&2
fi

flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
  || { echo "Sem internet ainda; tentando de novo daqui a pouco." >&2; exit 1; }
# A loja de apps mostra o Flathub completo, em vez do repositório reduzido do Fedora.
flatpak remote-modify --system --enable flathub || true
for r in fedora fedora-testing; do
  if flatpak remotes --system --columns=name | grep -qx "$r"; then
    flatpak remote-modify --system --disable "$r" || true
  fi
done

want="$(sha256sum "$LIST" | cut -d' ' -f1)"
if [[ -r $STAMP && "$(cat "$STAMP")" == "$want" ]]; then
  exit 0
fi

failed=0
while read -r app; do
  app="${app%%#*}"; app="${app//[[:space:]]/}"
  [[ -n $app ]] || continue
  echo "Instalando $app"
  flatpak install --system --noninteractive --or-update flathub "$app" || failed=1
done < "$LIST"

# Sobreposição de FPS do Matsu (MangoHud) também nos jogos abertos por apps
# Flatpak (Heroic, Lutris): eles precisam da camada Vulkan do MangoHud na mesma
# versão da base deles. A versão sai da própria base de cada app (a seção
# "Extension org.freedesktop.Platform.VulkanLayer" dela). Se não der, segue sem.
for app in com.heroicgameslauncher.hgl net.lutris.Lutris; do
  base="$(flatpak info --system --show-runtime "$app" 2>/dev/null)" || continue
  versao="$(flatpak info --system --show-metadata "$base" 2>/dev/null | awk '
    /^\[/ { dentro = ($0 == "[Extension org.freedesktop.Platform.VulkanLayer]") ; next }
    dentro && /^versions?=/ { sub(/^versions?=/, ""); split($0, v, ";"); print v[1]; exit }')"
  [[ -n $versao ]] || versao="${base##*/}"
  echo "Camada do MangoHud para $app (base $base): $versao"
  flatpak install --system --noninteractive --or-update flathub \
    "org.freedesktop.Platform.VulkanLayer.MangoHud//$versao" || echo "aviso: sem a camada do MangoHud $versao" >&2
done

if [[ $failed == 0 ]]; then
  mkdir -p "$(dirname "$STAMP")"
  echo "$want" > "$STAMP"
else
  echo "Alguns apps não instalaram; vai tentar de novo no próximo boot." >&2
fi

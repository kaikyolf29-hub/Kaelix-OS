# Central de jogos do Matsu: quando um jogo abre, liga o modo jogo (GameMode),
# o perfil gráfico dele (energia, placa de vídeo, limite de FPS) e a
# sobreposição; quando fecha, deixa tudo como estava.
[Unit]
Description=Central de jogos do Matsu (modo jogo automático)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I -S /usr/share/matsu/jogos/ajudante.py servico
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=graphical-session.target

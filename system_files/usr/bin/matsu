#!/usr/bin/bash
# matsu — o comando do Matsu OS (português e inglês).
# Licença: GPL-3.0-only. Repositório: matsu-os.
set -uo pipefail

IMAGE_INFO="${MATSU_IMAGE_INFO:-/usr/share/matsu/image-info.json}"
STATE_DIR="${MATSU_STATE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/matsu}"
FLATHUB_URL="https://dl.flathub.org/repo/flathub.flatpakrepo"
BAR_DIR="${MATSU_BAR_DIR:-/usr/share/matsu/barra}"
VIDRO_GEN="${MATSU_VIDRO_GEN:-/usr/share/matsu/vidro/gerar.py}"
VIDRO_DIR="${MATSU_VIDRO_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/plasma/desktoptheme/Matsu}"
KALI_NAME="${MATSU_KALI_NAME:-kali}"
KALI_IMAGE="docker.io/kalilinux/kali-rolling:latest"

# ---------------------------------------------------------------------------
# Idioma: português se o sistema estiver em português, senão inglês.
# MATSU_LANG=pt ou MATSU_LANG=en força um dos dois.
detect_lang() {
  local l="${MATSU_LANG:-${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}}"
  case "$l" in pt*) echo pt ;; *) echo en ;; esac
}
LANG_UI="$(detect_lang)"

# t "texto em português" "text in English"
t() { if [[ $LANG_UI == pt ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }

if [[ -t 1 ]]; then
  C_BOLD=$'\e[1m'; C_DIM=$'\e[2m'; C_OK=$'\e[32m'; C_WARN=$'\e[33m'; C_ERR=$'\e[31m'; C_ACC=$'\e[36m'; C_OFF=$'\e[0m'
else
  C_BOLD=; C_DIM=; C_OK=; C_WARN=; C_ERR=; C_ACC=; C_OFF=
fi

say()   { printf '%s\n' "$(t "$1" "$2")"; }
step()  { printf '%s==>%s %s\n' "$C_ACC" "$C_OFF" "$(t "$1" "$2")"; }
ok()    { printf '%s✔%s %s\n' "$C_OK" "$C_OFF" "$(t "$1" "$2")"; }
warn()  { printf '%s!%s %s\n' "$C_WARN" "$C_OFF" "$(t "$1" "$2")" >&2; }
fail()  { printf '%s✖%s %s\n' "$C_ERR" "$C_OFF" "$(t "$1" "$2")" >&2; exit 1; }
tip()   { printf '  %s%s%s\n' "$C_DIM" "$(t "$1" "$2")" "$C_OFF"; }

# Pergunta sim/não. Retorna 0 para sim. MATSU_YES=1 responde sim sozinho.
confirm() {
  [[ ${MATSU_YES:-0} == 1 ]] && return 0
  local answer
  printf '%s %s ' "$(t "$1" "$2")" "$(t "[s/N]" "[y/N]")"
  read -r answer || return 1
  case "${answer,,}" in s|sim|y|yes) return 0 ;; *) return 1 ;; esac
}

as_root() {
  if [[ $(id -u) -eq 0 ]]; then "$@"; else sudo "$@"; fi
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "O programa '$1' não foi encontrado." "The program '$1' was not found."
}

info_field() {
  [[ -r $IMAGE_INFO ]] || return 1
  jq -r --arg k "$1" '.[$k] // empty' "$IMAGE_INFO"
}

bootc_status() { as_root bootc status --format=json 2>/dev/null; }

# Imagem que está rodando agora, lida sem pedir senha (o rpm-ostree responde
# para qualquer usuário). Vazio se não der para saber.
booted_ref_noroot() {
  command -v rpm-ostree >/dev/null 2>&1 || return 0
  rpm-ostree status --booted --json 2>/dev/null \
    | jq -r '.deployments[0]["container-image-reference"] // empty' 2>/dev/null \
    | sed -E 's#^ostree-[a-z-]+:(docker://)?##'
}

# Imagem que está rodando agora, por exemplo ghcr.io/usuario/matsu-os:teste
booted_ref() {
  local ref
  ref="$(booted_ref_noroot)"
  if [[ -n $ref ]]; then printf '%s\n' "$ref"; return 0; fi
  bootc_status | jq -r '.status.booted.image.image.image // empty'
}

# ---------------------------------------------------------------------------
cmd_help() {
  cat <<EOF
${C_BOLD}$(system_name)${C_OFF} — $(t "comando do sistema" "system command")

$(t "Uso" "Usage"): matsu <$(t "comando" "command")>

  ${C_BOLD}atualizar${C_OFF} | update     $(t "Baixa e prepara a nova versão assinada do sistema" "Downloads and stages the new signed system version")
  ${C_BOLD}voltar${C_OFF}    | rollback   $(t "Volta para a versão anterior no próximo boot" "Goes back to the previous version on next boot")
  ${C_BOLD}drivers${C_OFF}               $(t "Mostra a placa de vídeo e confere o driver" "Shows the graphics card and checks the driver")
  ${C_BOLD}seguranca${C_OFF} | security   $(t "Abre o contêiner do Kali (cria na primeira vez)" "Opens the Kali container (creates it the first time)")
  ${C_BOLD}navegador${C_OFF} | browser    $(t "Instala o Google Chrome, o Brave ou os dois" "Installs Google Chrome, Brave or both")
  ${C_BOLD}barra${C_OFF}     | bar        $(t "Troca o estilo da barra: fusao, mac ou windows" "Changes the bar style: fusao, mac or windows")
  ${C_BOLD}vidro${C_OFF}     | glass      $(t "Escolhe a cor e a transparência do vidro da barra" "Picks the color and transparency of the bar glass")
  ${C_BOLD}versao${C_OFF}    | version    $(t "Mostra a versão do sistema" "Shows the system version")
  ${C_BOLD}ajuda${C_OFF}     | help       $(t "Mostra esta ajuda" "Shows this help")

$(t "Exemplos" "Examples"):
  matsu atualizar
  matsu atualizar --reiniciar   $(t "(atualiza e já reinicia)" "(updates and reboots right away)")
  matsu drivers --trocar        $(t "(troca para a imagem certa da sua placa)" "(switches to the right image for your card)")
  matsu seguranca remover       $(t "(apaga o contêiner do Kali)" "(deletes the Kali container)")
  matsu barra windows           $(t "(uma barra só embaixo, como no Windows)" "(a single bar at the bottom, like Windows)")
  matsu barra --tamanho grande  $(t "(barra maior; também pequena e media)" "(bigger bar; also pequena and media)")
  matsu barra --esconder maximizado  $(t "(a barra some com um app maximizado e volta com o mouse na borda; também sempre e nao)" "(the bar hides behind a maximized app and comes back with the mouse at the edge; also sempre and nao)")
  matsu barra --esconder-topo sempre $(t "(estilo Mac: a barra de cima também some; o padrão é tela-cheia)" "(Mac style: the top bar hides too; default is tela-cheia)")
  matsu barra --busca meio      $(t "(a busca vai para a ilha do meio, junto dos apps; também esquerda e nao)" "(search moves to the middle island, next to the apps; also esquerda and nao)")
  matsu barra --menu meio       $(t "(o menu também vai para o meio, como no Windows 11)" "(the menu moves to the middle too, like Windows 11)")
  matsu barra --telas principal $(t "(com várias telas, a barra só na principal; o padrão é todas)" "(with several screens, the bar only on the main one; default is todas)")
  matsu barra --abertos todas   $(t "(cada app aberto aparece em todas as barras; também tela e principal)" "(each open app shows on every bar; also tela and principal)")
  matsu barra apps              $(t "(mostra os apps fixados na barra)" "(shows the apps pinned to the bar)")
  matsu barra fixar kate        $(t "(põe um app na barra; tirar tira, ordem muda a ordem)" "(pins an app to the bar; unpin removes it, order reorders)")
  matsu vidro roxo --transparencia mais  $(t "(vidro roxo e mais transparente)" "(purple, more transparent glass)")
  matsu vidro --transparencia sem       $(t "(sem o efeito vidro: barra, menu e janelas sólidos)" "(no glass effect: solid bar, menu and windows)")
EOF
}

# ---------------------------------------------------------------------------
# atualizar / update
cmd_update() {
  local reboot=0 arg
  for arg in "$@"; do
    case "$arg" in
      --reiniciar|--reboot) reboot=1 ;;
      *) fail "Opção desconhecida: $arg" "Unknown option: $arg" ;;
    esac
  done
  need bootc; need jq

  local status ref sig
  step "Conferindo a versão atual" "Checking the current version"
  status="$(bootc_status)" || fail "Não consegui ler o estado do sistema (bootc status)." "Could not read the system state (bootc status)."
  ref="$(jq -r '.status.booted.image.image.image // empty' <<<"$status")"
  sig="$(jq -c '.spec.image.signature // "insecure"' <<<"$status")"
  [[ -n $ref ]] || fail "Este sistema não foi instalado a partir de uma imagem do Matsu." "This system was not installed from a Matsu image."
  tip "Imagem: $ref" "Image: $ref"

  if [[ $sig != *containerPolicy* ]]; then
    # Primeira vez: liga a verificação de assinatura para todas as próximas atualizações.
    step "Ligando a verificação de assinatura e atualizando" "Turning on signature checking and updating"
    as_root bootc switch --enforce-container-sigpolicy "$ref" \
      || fail "A atualização falhou. Nada foi mudado no sistema." "The update failed. Nothing was changed on the system."
  else
    step "Procurando atualização assinada" "Looking for a signed update"
    as_root bootc upgrade \
      || fail "A atualização falhou. Nada foi mudado no sistema." "The update failed. Nothing was changed on the system."
  fi

  if command -v flatpak >/dev/null 2>&1; then
    step "Atualizando os apps (Flatpak)" "Updating apps (Flatpak)"
    as_root flatpak update --system -y --noninteractive || warn "Alguns apps não atualizaram." "Some apps did not update."
    flatpak update --user -y --noninteractive >/dev/null 2>&1 || true
  fi

  local staged
  staged="$(bootc_status | jq -r '.status.staged.image.image.image // empty')"
  if [[ -n $staged ]]; then
    ok "Nova versão pronta. Ela entra quando você reiniciar." "New version ready. It takes effect when you reboot."
    tip "Se algo der errado depois, use: matsu voltar" "If something goes wrong afterwards, use: matsu rollback"
    if [[ $reboot == 1 ]]; then
      step "Reiniciando" "Rebooting"
      as_root systemctl reboot
    fi
  else
    ok "O sistema já está na versão mais nova." "The system is already on the newest version."
  fi
}

# ---------------------------------------------------------------------------
# voltar / rollback
cmd_rollback() {
  need bootc; need jq
  local status rb
  status="$(bootc_status)" || fail "Não consegui ler o estado do sistema (bootc status)." "Could not read the system state (bootc status)."
  rb="$(jq -r '.status.rollback.image.image.image // empty' <<<"$status")"
  if [[ -z $rb ]]; then
    warn "Não existe versão anterior guardada para voltar." "There is no previous version saved to go back to."
    exit 1
  fi
  say "A versão anterior ($rb) vai ser usada no próximo boot." "The previous version ($rb) will be used on next boot."
  confirm "Quer voltar para ela?" "Do you want to go back to it?" || { say "Nada foi mudado." "Nothing was changed."; exit 0; }
  as_root bootc rollback || fail "Não consegui voltar a versão." "Could not roll back."
  ok "Pronto. Reinicie para usar a versão anterior." "Done. Reboot to use the previous version."
  tip "Também dá para escolher a versão anterior no menu de boot." "You can also pick the previous version in the boot menu."
}

# ---------------------------------------------------------------------------
# drivers
gpu_vendors() {
  # Lista os fabricantes das placas de vídeo: nvidia, amd, intel.
  lspci -nn 2>/dev/null | grep -Ei 'VGA|3D controller|Display controller' | while read -r line; do
    case "$line" in
      *"[10de:"*) echo nvidia ;;
      *"[1002:"*) echo amd ;;
      *"[8086:"*) echo intel ;;
      *) echo other ;;
    esac
  done | sort -u
}

cmd_drivers() {
  local do_switch=0 arg
  for arg in "$@"; do
    case "$arg" in
      --trocar|--switch) do_switch=1 ;;
      *) fail "Opção desconhecida: $arg" "Unknown option: $arg" ;;
    esac
  done
  need lspci; need jq

  step "Placas de vídeo encontradas" "Graphics cards found"
  lspci -nnk 2>/dev/null | grep -EiA3 'VGA|3D controller|Display controller' | grep -Ei 'VGA|3D|Display|driver in use' | sed 's/^/  /'

  local vendors variant want=""
  vendors="$(gpu_vendors)"
  variant="$(info_field image-variant || echo main)"
  [[ -n $variant ]] || variant=main
  tip "Imagem instalada: variante '$variant'" "Installed image: '$variant' variant"

  if grep -qx nvidia <<<"$vendors"; then
    [[ $variant == nvidia ]] || want=nvidia
  elif [[ $variant == nvidia ]]; then
    want=main
  fi

  if [[ -z $want ]]; then
    ok "O driver certo para a sua placa já vem no sistema." "The right driver for your card is already in the system."
    if command -v fwupdmgr >/dev/null 2>&1; then
      tip "Para atualizar o firmware (BIOS, SSD): fwupdmgr get-updates" "To update firmware (BIOS, SSD): fwupdmgr get-updates"
    fi
    return 0
  fi

  local target_name ref registry tag
  if [[ $want == nvidia ]]; then
    target_name=matsu-os-nvidia
    warn "Você tem uma placa NVIDIA, mas está na imagem sem o driver da NVIDIA." "You have an NVIDIA card but are on the image without the NVIDIA driver."
  else
    target_name=matsu-os
    warn "Você está na imagem NVIDIA, mas não tem placa NVIDIA." "You are on the NVIDIA image but have no NVIDIA card."
  fi

  registry="$(info_field image-registry)"
  ref="$(booted_ref)"
  tag="${ref##*:}"
  [[ -n $ref && $tag != "$ref" ]] || tag=estavel
  [[ -n $registry ]] || fail "Não sei de onde baixar a imagem (image-info.json)." "I don't know where to download the image from (image-info.json)."
  local target="${registry}/${target_name}:${tag}"

  if [[ $do_switch == 0 ]]; then
    say "Para trocar para a imagem certa, rode: matsu drivers --trocar" "To switch to the right image, run: matsu drivers --switch"
    return 0
  fi
  confirm "Trocar para $target?" "Switch to $target?" || { say "Nada foi mudado." "Nothing was changed."; return 0; }
  need bootc
  as_root bootc switch --enforce-container-sigpolicy "$target" \
    || fail "A troca falhou. Nada foi mudado no sistema." "The switch failed. Nothing was changed on the system."
  ok "Pronto. Reinicie para usar a nova imagem." "Done. Reboot to use the new image."
}

# ---------------------------------------------------------------------------
# seguranca / security
kali_exists() {
  distrobox list --no-color 2>/dev/null | awk -F'|' 'NR>1 {gsub(/ /,"",$2); print $2}' | grep -qx "$KALI_NAME"
}

cmd_security() {
  need distrobox
  local action="${1:-entrar}"
  case "$action" in
    entrar|enter|"") ;;
    remover|remove)
      if ! kali_exists; then say "O contêiner do Kali não existe." "The Kali container does not exist."; return 0; fi
      confirm "Apagar o contêiner do Kali e tudo dentro dele?" "Delete the Kali container and everything inside it?" || return 0
      distrobox rm --force "$KALI_NAME" && ok "Contêiner do Kali apagado." "Kali container deleted."
      return 0 ;;
    *) fail "Opção desconhecida: $action" "Unknown option: $action" ;;
  esac

  if ! kali_exists; then
    say "O Kali vai rodar dentro de um contêiner. O sistema principal continua limpo." \
        "Kali will run inside a container. The main system stays clean."
    say "Isso baixa alguns GB e pode demorar." "This downloads a few GB and may take a while."
    confirm "Criar o contêiner do Kali agora?" "Create the Kali container now?" || { say "Nada foi feito." "Nothing was done."; return 0; }
    step "Criando o contêiner do Kali" "Creating the Kali container"
    distrobox create --yes --name "$KALI_NAME" --image "$KALI_IMAGE" \
      || fail "Não consegui criar o contêiner." "Could not create the container."
    step "Instalando as ferramentas do Kali (kali-linux-headless)" "Installing Kali tools (kali-linux-headless)"
    distrobox enter "$KALI_NAME" -- sh -c 'sudo apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y kali-linux-headless' \
      || warn "Algumas ferramentas não instalaram. Dá para tentar de novo dentro do contêiner." "Some tools did not install. You can try again inside the container."
    ok "Contêiner do Kali pronto." "Kali container ready."
  fi
  tip "Para sair do Kali, digite: exit" "To leave Kali, type: exit"
  exec distrobox enter "$KALI_NAME"
}

# ---------------------------------------------------------------------------
# navegador / browser
# Deixa o navegador instalado como padrão do sistema. A barra mostra o navegador
# padrão, então ele toma o lugar do Firefox, que continua instalado como reserva.
set_default_browser() {
  local desktop="$1"
  if command -v xdg-settings >/dev/null 2>&1 && xdg-settings set default-web-browser "$desktop" 2>/dev/null; then
    :
  elif command -v xdg-mime >/dev/null 2>&1; then
    xdg-mime default "$desktop" x-scheme-handler/http x-scheme-handler/https text/html || return 1
  else
    return 1
  fi
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kdeglobals --group General --key BrowserApplication "$desktop" || true
  fi
  refresh_bar_browser
}

# A barra só confere qual é o navegador padrão quando a lista de apps muda.
# Tira e põe de volta o "navegador padrão" para ela trocar o ícone na hora.
refresh_bar_browser() {
  [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] || return 0
  command -v busctl >/dev/null 2>&1 || return 0
  local script='var ps = panels();
for (var i = 0; i < ps.length; i++) {
  var ids = ps[i].widgetIds;
  for (var j = 0; j < ids.length; j++) {
    var w = ps[i].widgetById(ids[j]);
    if (w.type !== "org.matsu.doca" && w.type !== "org.kde.plasma.icontasks" && w.type !== "org.kde.plasma.taskmanager") continue;
    w.currentConfigGroup = ["General"];
    var lista = String(w.readConfig("launchers", "")).split(",").filter(function (x) { return x.length > 0; });
    if (lista.indexOf("preferred://browser") === -1) continue;
    w.writeConfig("launchers", lista.filter(function (x) { return x !== "preferred://browser"; }));
    w.writeConfig("launchers", lista);
  }
}'
  busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "$script" >/dev/null 2>&1 || true
}

install_flatpak_user() {
  flatpak remote-add --user --if-not-exists flathub "$FLATHUB_URL" >/dev/null 2>&1 || true
  flatpak install --user -y --noninteractive flathub "$1"
}

cmd_browser() {
  need flatpak
  local first=0 choice=""
  local arg
  for arg in "$@"; do
    case "$arg" in
      --primeira-vez|--first-run) first=1 ;;
      chrome|brave) choice="$arg" ;;
      os-dois|ambos|both) choice="chrome brave" ;;
      nenhum|none) choice="none" ;;
      *) fail "Opção desconhecida: $arg" "Unknown option: $arg" ;;
    esac
  done

  local stamp="$STATE_DIR/navegador-escolhido"
  if [[ $first == 1 && -e $stamp ]]; then return 0; fi

  if [[ -z $choice ]]; then
    local has_gui=0
    if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v kdialog >/dev/null 2>&1; then has_gui=1; fi

    if [[ $first == 1 ]]; then
      # No primeiro login a pergunta só vale com a janela. Se a área de trabalho
      # ainda não está pronta, sai sem marcar nada e tenta de novo no próximo login.
      if [[ $has_gui == 0 ]]; then
        warn "Área de trabalho ainda não está pronta; pergunto no próximo login." "Desktop is not ready yet; will ask on next login."
        return 0
      fi
      sleep "${MATSU_FIRST_DELAY:-12}"
      # Se a tela de boas-vindas do Matsu está aberta, a escolha é feita nela.
      # Sem marcar nada: se a pessoa fechar sem escolher, pergunto no próximo login.
      if pgrep -x plasma-welcome >/dev/null 2>&1; then
        say "A tela de boas-vindas está aberta; a escolha do navegador fica com ela." "The welcome screen is open; the browser choice is made there."
        return 0
      fi
    fi

    if [[ $has_gui == 1 ]]; then
      local rc=0
      choice="$(kdialog --title "Matsu" --checklist \
        "$(t "Qual navegador você quer instalar? Pode escolher os dois." "Which browser do you want to install? You can pick both.")" \
        chrome "Google Chrome" off brave "Brave" off | tr -d '"'; exit "${PIPESTATUS[0]}")" || rc=$?
      # 0 = OK, 1 = Cancelar. Qualquer outro número é a janela que não abriu.
      if [[ $rc -gt 1 ]]; then
        warn "A janela de escolha não abriu (kdialog saiu com $rc)." "The chooser window did not open (kdialog exited with $rc)."
        if [[ $first == 1 ]]; then return 0; fi
        return 1
      fi
      if [[ $rc -eq 1 || -z $choice ]]; then choice="none"; fi
    else
      say "Qual navegador você quer instalar?" "Which browser do you want to install?"
      say "  1) Google Chrome   2) Brave   3) $(t "Os dois" "Both")   4) $(t "Nenhum" "None")" \
          "  1) Google Chrome   2) Brave   3) Both   4) None"
      local n; read -r n || n=4
      case "$n" in 1) choice=chrome ;; 2) choice=brave ;; 3) choice="chrome brave" ;; *) choice=none ;; esac
    fi
  fi

  local failed=0 b padrao=""
  if [[ $choice != none ]]; then
    for b in $choice; do
      case "$b" in
        chrome) step "Instalando o Google Chrome" "Installing Google Chrome"
                if install_flatpak_user com.google.Chrome; then padrao="${padrao:-com.google.Chrome.desktop}"; else failed=1; fi ;;
        brave)  step "Instalando o Brave" "Installing Brave"
                if install_flatpak_user com.brave.Browser; then padrao="${padrao:-com.brave.Browser.desktop}"; else failed=1; fi ;;
      esac
    done
  fi
  # O primeiro que instalou vira o padrão (com os dois, o Chrome, que vem primeiro na lista).
  if [[ -n $padrao ]]; then
    if set_default_browser "$padrao"; then
      ok "Agora ele é o navegador padrão e fica na barra no lugar do Firefox." "It is now the default browser and takes Firefox's place on the bar."
    else
      warn "Não consegui deixar como padrão; dá para escolher em Configurações > Aplicativos padrão." "Could not set it as default; choose it in Settings > Default Applications."
    fi
  fi

  if [[ $failed == 1 ]]; then
    warn "Não consegui instalar. Confira a internet e rode: matsu navegador" "Could not install. Check the internet and run: matsu browser"
    return 1
  fi
  mkdir -p "$STATE_DIR" && : > "$stamp"
  if [[ $choice == none ]]; then
    say "Tudo bem. Para instalar depois: matsu navegador" "Okay. To install later: matsu browser"
  else
    ok "Navegador instalado." "Browser installed."
  fi
}

# ---------------------------------------------------------------------------
# versao / version
# ---------------------------------------------------------------------------
# Estilo da barra: fusao (três ilhas embaixo), mac (barra no topo e doca) ou
# windows (uma barra só embaixo). Guarda a escolha para trocar só o tamanho depois.
bar_saved() { # bar_saved <chave> <padrão>
  local v=""
  [[ -r $STATE_DIR/barra ]] && v="$(sed -n "s/^$1=//p" "$STATE_DIR/barra" | head -n1)"
  printf '%s' "${v:-$2}"
}

# Manda um roteiro para a área de trabalho (Plasma) e devolve a resposta.
bar_script() {
  busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "$1"
}

# A resposta vem como  s "linha 1\nlinha 2"; aqui vira linhas de verdade.
bar_reply_lines() {
  local r="$1"
  r="${r#s \"}"; r="${r%\"}"
  printf '%b\n' "$r"
}

# As escolhas da pessoa, como variáveis no começo do roteiro da barra (veja
# o começo de /usr/share/matsu/barra/comum.js).
# A barra de cima do estilo Mac se esconde como em BAR_ESCONDER_TOPO (quem
# chama põe o valor novo) ou como está guardado.
bar_vars() { # bar_vars <tamanho> <esconder> <busca> <menu> <telas> <abertos> [estilo]
  local scale esconde topo
  case "$1" in pequena) scale=2.25 ;; grande) scale=3.25 ;; media) scale=2.75 ;; *) scale="$(bar_scale "$1")" ;; esac
  esconde="$(bar_hide_mode "$2")" || esconde=nao
  topo="$(bar_hide_top_mode "${BAR_ESCONDER_TOPO:-$(bar_saved esconder_topo tela-cheia)}")" || topo=tela-cheia
  printf 'var matsuEscala = %s;\nvar matsuEsconder = "%s";\nvar matsuEsconderTopo = "%s";\nvar matsuBusca = "%s";\nvar matsuMenu = "%s";\nvar matsuTelas = "%s";\nvar matsuAbertos = "%s";\n' \
    "$scale" "$esconde" "$topo" "$3" "$4" "$5" "$6"
  if [[ ${7:-} =~ ^(fusao|mac|windows)$ ]]; then printf 'var matsuEstilo = "%s";\n' "$7"; fi
  bar_dock_vars
}

# O tamanho livre da doca do Mac (a régua "Tamanho" dos Ajustes): um número
# de 1,8 a 4,2 (vezes a letra do sistema). Fora disso, ou se não for número, o médio.
bar_scale() {
  local v="${1/,/.}"
  if [[ $v =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v v="$v" 'BEGIN { exit !(v >= 1.8 && v <= 4.2) }'; then
    printf '%s' "$v"
  else
    printf '2.75'
  fi
}

# Os ajustes da doca guardados (ampliação, pontinhos, pulo ao abrir, lugar da
# doca no estilo Mac), como variáveis do roteiro da barra (veja comum.js).
bar_dock_vars() {
  local amp nivel ind ani pos
  amp="$(bar_saved ampliacao sim)"; nivel="$(bar_saved ampliacao_nivel 50)"
  ind="$(bar_saved indicadores sim)"; ani="$(bar_saved animar sim)"; pos="$(bar_saved posicao embaixo)"
  [[ $nivel =~ ^[0-9]{1,3}$ ]] && (( nivel <= 100 )) || nivel=50
  [[ $pos =~ ^(embaixo|esquerda|direita)$ ]] || pos=embaixo
  printf 'var matsuAmpliacao = %s;\nvar matsuAmpliacaoNivel = %s;\nvar matsuIndicadores = %s;\nvar matsuAnimar = %s;\nvar matsuPosicao = "%s";\n' \
    "$([[ $amp == nao ]] && echo false || echo true)" "$nivel" \
    "$([[ $ind == nao ]] && echo false || echo true)" "$([[ $ani == nao ]] && echo false || echo true)" "$pos"
}

# Guarda tudo o que a pessoa escolheu para a barra (e para a doca).
bar_write_state() { # bar_write_state <estilo> <tamanho> <esconder> <busca> <menu> <telas> <abertos> <ampliacao> <nivel> <indicadores> <animar> <posicao> <esconder_topo>
  mkdir -p "$STATE_DIR" && printf 'estilo=%s\ntamanho=%s\nesconder=%s\nbusca=%s\nmenu=%s\ntelas=%s\nabertos=%s\nampliacao=%s\nampliacao_nivel=%s\nindicadores=%s\nanimar=%s\nposicao=%s\nesconder_topo=%s\n' \
    "$@" > "$STATE_DIR/barra"
}

# Quando a barra (no estilo Mac, a doca) se esconde sozinha: nao, maximizado
# (some quando uma janela encosta nela, como um app maximizado) ou sempre. Nos
# dois, ela volta quando o mouse encosta na borda da tela. "sim" era o "sempre".
bar_hide_mode() {
  case "${1,,}" in
    nao|não|n|no|off|false|0|nunca|never)                                   printf 'nao' ;;
    maximizado|maximizada|maximized|max|janela|janelas|windows|dodge|cobrir) printf 'maximizado' ;;
    sempre|always|sim|s|yes|y|on|true|1|auto)                               printf 'sempre' ;;
    *) return 1 ;;
  esac
}

# A barra de cima do estilo Mac: some só com um app em tela cheia (o padrão,
# como no Mac), com um app maximizado ou sempre.
bar_hide_top_mode() {
  case "${1,,}" in
    tela-cheia|telacheia|cheia|fullscreen|nao|não|n|no|off|false|0|nunca|never) printf 'tela-cheia' ;;
    maximizado|maximizada|maximized|max|janela|janelas|windows|dodge|cobrir)     printf 'maximizado' ;;
    sempre|always|sim|s|yes|y|on|true|1|auto)                                   printf 'sempre' ;;
    *) return 1 ;;
  esac
}

# Um "sim/não" das opções da doca.
bar_yes_no() { # bar_yes_no <valor> <opção>
  case "${1,,}" in
    sim|s|yes|y|on|true|1|ligar|ligada)        printf 'sim' ;;
    nao|não|n|no|off|false|0|desligar|desligada) printf 'nao' ;;
    *) fail "Use $2 sim ou $2 nao." "Use $2 on or $2 off." ;;
  esac
}

# Uma tela foi ligada (ou a sessão começou com mais de uma): põe a barra do
# estilo da pessoa nas telas que ainda não têm nenhuma. Quem chama é o serviço
# matsu-telas, que o KWin liga quando as telas mudam. Espera a área de
# trabalho abrir, e não faz nada se a pessoa quer a barra só na principal.
bar_new_screens() { # bar_new_screens <estilo> <tamanho> <esconder> <busca> <menu> <telas> <abertos>
  local style="$1" f script reply tentativa
  [[ $6 == principal ]] && return 0
  [[ $style =~ ^(fusao|mac|windows)$ ]] || style=fusao
  for f in comum.js "$style.js" telas-novas.js; do
    [[ -r $BAR_DIR/$f ]] || fail "Não achei o arquivo do estilo: $BAR_DIR/$f" "Style file not found: $BAR_DIR/$f"
  done
  need busctl
  script="$(bar_vars "$2" "$3" "$4" "$5" "$6" "$7"; cat "$BAR_DIR/comum.js" "$BAR_DIR/$style.js" "$BAR_DIR/telas-novas.js")"
  # A área de trabalho leva um instante para ver a tela que acabou de ligar.
  sleep "${MATSU_TELAS_INICIO:-3}"
  for ((tentativa = 1; tentativa <= ${MATSU_TELAS_TENTATIVAS:-12}; tentativa++)); do
    if reply="$(bar_script "$script" 2>/dev/null)"; then
      bar_reply_lines "$reply" | grep '^matsu-telas: ' || true
      [[ $reply == *"matsu-telas: pronto"* ]] && return 0
    fi
    sleep "${MATSU_TELAS_ESPERA:-5}"
  done
  say "A área de trabalho não ficou pronta; as telas novas ficam sem barra por enquanto." \
      "The desktop did not get ready; the new screens stay without a bar for now."
  return 0
}

# ---------------------------------------------------------------------------
# Apps fixados na barra (os mesmos em todas as telas): ver, fixar, tirar e pôr
# em ordem. "matsu barra apps", "matsu barra fixar kate", "matsu barra tirar
# steam", "matsu barra ordem arquivos,navegador,steam", "matsu barra apps --padrao".
# Os Ajustes do Matsu e o menu usam as mesmas coisas pelo matsu-central.

# As pastas dos atalhos de apps (.desktop), da mais forte para a mais fraca: um
# atalho da pessoa vale mais que o do sistema com o mesmo nome.
app_dirs() {
  local d IFS=:
  if [[ -n ${MATSU_APPS_DIRS:-} ]]; then
    for d in $MATSU_APPS_DIRS; do printf '%s\n' "$d"; done
    return
  fi
  printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  for d in ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do printf '%s\n' "$d/applications"; done
  printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share/applications" \
    /var/lib/flatpak/exports/share/applications
}

app_files() {
  local d f
  local -A visto=()
  while IFS= read -r d; do
    [[ -d $d ]] || continue
    for f in "$d"/*.desktop; do
      [[ -f $f && -z ${visto[${f##*/}]:-} ]] || continue
      visto[${f##*/}]=1
      printf '%s\n' "$f"
    done
  done < <(app_dirs | awk '!visto[$0]++')
}

# Uma linha por app: arquivo|id|nome|ícone|aparece (1 ou 0). O nome vem em
# português quando o app tem tradução. "Aparece" é o que o menu mostraria.
app_table() {
  local files=() pt=0
  mapfile -t files < <(app_files)
  (( ${#files[@]} )) || return 0
  [[ $LANG_UI == pt ]] && pt=1
  awk -v pt="$pt" '
    function flush() {
      if (arq == "") return
      nome = (pt && nptbr != "") ? nptbr : ((pt && npt != "") ? npt : n)
      vis = (tipo == "Application" && nodisp != "true" && hidden != "true" && nome != "") ? 1 : 0
      if (only != "" && only !~ /(^|;)KDE(;|$)/) vis = 0
      if (notin ~ /(^|;)KDE(;|$)/) vis = 0
      id = arq; sub(/.*\//, "", id)
      gsub(/\|/, "/", nome)
      print arq "|" id "|" nome "|" icone "|" vis
    }
    FNR == 1 { flush(); arq = FILENAME; sec = ""; n = npt = nptbr = icone = tipo = nodisp = hidden = only = notin = "" }
    /^\[/ { sec = $0; next }
    sec != "[Desktop Entry]" { next }
    {
      i = index($0, "="); if (!i) next
      k = substr($0, 1, i - 1); v = substr($0, i + 1)
      sub(/[ \t]+$/, "", k); sub(/^[ \t]+/, "", v)
      if (k == "Name") n = v
      else if (k == "Name[pt_BR]") nptbr = v
      else if (k == "Name[pt]") npt = v
      else if (k == "Icon") icone = v
      else if (k == "Type") tipo = v
      else if (k == "NoDisplay") nodisp = tolower(v)
      else if (k == "Hidden") hidden = tolower(v)
      else if (k == "OnlyShowIn") only = v
      else if (k == "NotShowIn") notin = v
    }
    END { flush() }
  ' "${files[@]}"
}

# A categoria de cada app, como a vista "Apps" do Mac e a exibição por
# categoria do Menu Iniciar do Windows 11, pelo Categories= do atalho. Uma
# linha por app que aparece no menu: id|categoria, com a categoria entre
# utilitarios, produtividade, internet, criatividade, leitura, entretenimento,
# jogos, desenvolvimento e outros. A ordem dos testes decide os casos de duas
# categorias (a Steam é Network e Game: vai para jogos; o VLC é Player e
# Recorder: vai para entretenimento; o Okular é Graphics e Office: leitura).
app_categories() {
  local files=()
  mapfile -t files < <(app_files)
  (( ${#files[@]} )) || return 0
  awk '
    function tem(lista) { return cats ~ ("(^|;)(" lista ")(;|$)") }
    function flush() {
      if (arq == "") return
      if (tipo != "Application" || nodisp == "true" || hidden == "true") return
      if (only != "" && only !~ /(^|;)KDE(;|$)/) return
      if (notin ~ /(^|;)KDE(;|$)/) return
      id = arq; sub(/.*\//, "", id)
      if (tem("Game")) c = "jogos"
      else if (tem("Development|IDE|Debugger|RevisionControl|GUIDesigner|Building|Profiling|WebDevelopment")) c = "desenvolvimento"
      else if (tem("Viewer") && tem("Office|Literature|Documentation|Publishing")) c = "leitura"
      else if (tem("Player|TV|Tuner")) c = "entretenimento"
      else if (tem("Graphics|2DGraphics|3DGraphics|RasterGraphics|VectorGraphics|Photography|Scanning|AudioVideoEditing|Recorder|Midi|Mixer|Sequencer|Art|Publishing")) c = "criatividade"
      else if (tem("Office|WordProcessor|Spreadsheet|Presentation|Calendar|ContactManagement|Finance|ProjectManagement|Database|Chart|Dictionary")) c = "produtividade"
      else if (tem("Network|WebBrowser|Email|Chat|InstantMessaging|IRCClient|VideoConference|Telephony|FileTransfer|P2P|News|Feed|RemoteAccess")) c = "internet"
      else if (tem("AudioVideo|Audio|Video|Music")) c = "entretenimento"
      else if (tem("Education|Science|Literature|Viewer|Documentation|Maps|Geography|Math|Astronomy|Languages|Spirituality|Humanities")) c = "leitura"
      else if (tem("Utility|System|Settings|FileManager|FileTools|TerminalEmulator|Monitor|Accessibility|Archiving|Compression|Calculator|Clock|TextEditor|Security|PackageManager|HardwareSettings|DesktopSettings|Filesystem|Emulator|Core")) c = "utilitarios"
      else c = "outros"
      print id "|" c
    }
    FNR == 1 { flush(); arq = FILENAME; sec = ""; cats = tipo = nodisp = hidden = only = notin = "" }
    /^\[/ { sec = $0; next }
    sec != "[Desktop Entry]" { next }
    {
      i = index($0, "="); if (!i) next
      k = substr($0, 1, i - 1); v = substr($0, i + 1)
      sub(/[ \t]+$/, "", k); sub(/^[ \t]+/, "", v)
      if (k == "Categories") cats = v
      else if (k == "Type") tipo = v
      else if (k == "NoDisplay") nodisp = tolower(v)
      else if (k == "Hidden") hidden = tolower(v)
      else if (k == "OnlyShowIn") only = v
      else if (k == "NotShowIn") notin = v
    }
    END { flush() }
  ' "${files[@]}"
}

# O app padrão do sistema para "navegador" e "arquivos" (a barra guarda esses
# dois como preferred://browser e preferred://filemanager).
default_app() { # default_app browser|filemanager
  local id=""
  if [[ $1 == browser ]]; then
    command -v xdg-settings >/dev/null 2>&1 && id="$(timeout 3 xdg-settings get default-web-browser 2>/dev/null)"
    if [[ -z $id ]] && command -v kreadconfig6 >/dev/null 2>&1; then
      id="$(kreadconfig6 --file kdeglobals --group General --key BrowserApplication 2>/dev/null)"
    fi
  else
    command -v xdg-mime >/dev/null 2>&1 && id="$(timeout 3 xdg-mime query default inode/directory 2>/dev/null)"
  fi
  id="${id%%$'\n'*}"; id="${id#\!}"
  [[ $id == *.desktop ]] && printf '%s\n' "$id"
  return 0
}

# O atalho (.desktop) que um app da barra abre: applications:x.desktop -> x.desktop
pin_desktop() { # pin_desktop <app>
  case "$1" in
    preferred://browser)     default_app browser ;;
    preferred://filemanager) default_app filemanager ;;
    applications:*)          printf '%s\n' "${1#applications:}" ;;
    file://*)                printf '%s\n' "${1##*/}" ;;
  esac
}

# Nome e ícone de um app da barra, para mostrar: nome|ícone|atalho
pin_label() { # pin_label <app> <tabela de app_table>
  local app="$1" desk nome="" icone=""
  desk="$(pin_desktop "$app")"
  if [[ -n $desk ]]; then
    IFS='|' read -r _ _ nome icone _ < <(awk -F'|' -v d="$desk" '$2 == d { print; exit }' <<<"$2")
  fi
  if [[ -z $nome ]]; then
    case "$app" in
      preferred://browser)     nome="$(t "Navegador" "Browser")"; icone="${icone:-internet-web-browser}" ;;
      preferred://filemanager) nome="$(t "Arquivos" "Files")"; icone="${icone:-system-file-manager}" ;;
      *) nome="${desk%.desktop}"; nome="${nome:-$app}"; nome="${nome##*.}"; icone="${icone:-application-x-executable}" ;;
    esac
  fi
  printf '%s|%s|%s\n' "$nome" "${icone:-application-x-executable}" "$desk"
}

# Acha o app que a pessoa digitou (nome do arquivo, nome do app ou um pedaço)
# e devolve como a barra guarda: applications:x.desktop.
app_resolve() { # app_resolve <texto> <tabela>
  local q="$1" ql achado=""
  case "$q" in
    applications:*|preferred://*|file://*) printf '%s\n' "$q"; return 0 ;;
  esac
  ql="${q,,}"
  case "$ql" in
    navegador|browser|internet)                   echo "preferred://browser"; return 0 ;;
    arquivos|files|gerenciador-de-arquivos|filemanager) echo "preferred://filemanager"; return 0 ;;
  esac
  if [[ $q == /*.desktop && -f $q ]]; then printf 'file://%s\n' "$q"; return 0; fi
  ql="${ql%.desktop}"
  achado="$(awk -F'|' -v q="$ql" '
    { id = tolower($2); sub(/\.desktop$/, "", id); nome = tolower($3); m = split(id, p, ".") }
    id == q                         { print $2; exit }
    $5 == 1 && nome == q            { if (!a) a = $2 }
    $5 == 1 && p[m] == q            { if (!b) b = $2 }
    $5 == 1 && (index(id, q) || index(nome, q)) { if (!c) c = $2 }
    END { if (a) print a; else if (b) print b; else if (c) print c }' <<<"$2" | head -n1)"
  [[ -n $achado ]] || return 1
  printf 'applications:%s\n' "$achado"
}

# Acha, entre os apps fixados, o que a pessoa digitou (para tirar ou pôr em
# ordem). Vale o nome do app, o arquivo ou o app padrão (firefox = navegador).
pin_match() { # pin_match <texto> <fixados> <tabela>
  local q="$1" fixados="$2" tabela="$3" alvo desk app ql
  ql="${q,,}"
  alvo="$(app_resolve "$q" "$tabela")" || alvo=""
  [[ -n $alvo ]] && desk="$(pin_desktop "$alvo")" || desk=""
  while IFS= read -r app; do
    [[ -n $app ]] || continue
    if [[ $app == "$alvo" || ( -n $desk && "$(pin_desktop "$app")" == "$desk" ) ]]; then
      printf '%s\n' "$app"; return 0
    fi
  done <<<"$fixados"
  while IFS= read -r app; do
    [[ -n $app ]] || continue
    if [[ ${app,,} == *"$ql"* || "$(pin_label "$app" "$tabela" | cut -d'|' -f1 | tr '[:upper:]' '[:lower:]')" == *"$ql"* ]]; then
      printf '%s\n' "$app"; return 0
    fi
  done <<<"$fixados"
  return 1
}

# Manda a ação para a barra. Depois dela: BAR_FIXADOS (os apps fixados, um por
# linha), BAR_LIMITE (quantos apps cabem na barra; 0 se a barra não disse) e
# BAR_NAO_COUBE (os apps que não couberam, um por linha).
BAR_FIXADOS="" BAR_LIMITE=0 BAR_NAO_COUBE=""
bar_pins() { # bar_pins <ler|fixar|tirar|ordem|padrao> [apps...]
  local acao="$1" lista="" a f reply linhas estilo
  shift
  for a in "$@"; do
    a="${a//\\/\\\\}"; a="${a//\"/\\\"}"
    lista+="${lista:+,}\"$a\""
  done
  for f in comum.js fixados.js; do
    [[ -r $BAR_DIR/$f ]] || fail "Não achei o arquivo da barra: $BAR_DIR/$f" "Bar file not found: $BAR_DIR/$f"
  done
  need busctl
  # O limite depende do estilo, do lugar da busca e do menu (o que divide a
  # barra com os apps). Sem escolha guardada, a área de trabalho descobre.
  estilo=""; [[ -r $STATE_DIR/barra ]] && estilo="$(bar_saved estilo fusao)"
  reply="$(bar_script "$(printf 'var matsuAcao = "%s";\nvar matsuApps = [%s];\n' "$acao" "$lista"
                         bar_vars "$(bar_saved tamanho media)" nao "$(bar_saved busca esquerda)" "$(bar_saved menu esquerda)" \
                           "$(bar_saved telas todas)" "$(bar_saved abertos tela)" "$estilo"
                         cat "$BAR_DIR/comum.js" "$BAR_DIR/fixados.js")")" \
    || fail "Não consegui falar com a área de trabalho. Rode este comando dentro da sessão do Matsu." \
            "Could not reach the desktop. Run this command inside the Matsu session."
  linhas="$(bar_reply_lines "$reply")"
  if grep -q '^matsu-fixados: sem-barra' <<<"$linhas"; then
    fail "A barra de agora não tem lugar para apps fixados. Troque o estilo com: matsu barra fusao" \
         "The current bar has no place for pinned apps. Change the style with: matsu bar fusao"
  fi
  grep -q '^matsu-fixados: pronto' <<<"$linhas" \
    || fail "A área de trabalho não respondeu direito. Tente de novo." "The desktop did not answer properly. Try again."
  BAR_FIXADOS="$(sed -n 's/^matsu-fixado: //p' <<<"$linhas")"
  BAR_NAO_COUBE="$(sed -n 's/^matsu-nao-coube: //p' <<<"$linhas")"
  BAR_LIMITE="$(sed -n 's/^matsu-limite: \([0-9][0-9]*\)$/\1/p' <<<"$linhas" | head -n1)"
  BAR_LIMITE="${BAR_LIMITE:-0}"
}

# O aviso gentil de quando a barra está cheia. No estilo Mac a doca cabe mais.
bar_cheia_msg() { # bar_cheia_msg <limite>
  if [[ "$(bar_saved estilo fusao)" == mac ]]; then
    t "A doca cabe até $1 apps." "The dock fits up to $1 apps."
  else
    t "A barra cabe até $1 apps. No estilo Mac a doca cabe mais." "The bar fits up to $1 apps. The Mac style dock fits more."
  fi
}

# Fora do terminal (o "Fixar na barra" do menu chama pelo matsu-central), o
# aviso vai também como notificação, senão a pessoa não vê nada acontecer.
bar_avisar() { # bar_avisar <título> <texto>
  [[ -t 1 || -t 2 ]] && return 0
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send --app-name="Matsu" --icon=matsu-barra-symbolic "$1" "$2" >/dev/null 2>&1 || true
}

cmd_bar_apps() { # cmd_bar_apps <apps|fixar|tirar|ordem> [args...]
  local verbo="$1" modo=pessoa tabela fixados a app n=0 nome icone desk
  local -a apps=()
  shift
  tabela="$(app_table)"
  case "$verbo" in
    apps|fixados|pinned)
      case "${1:-}" in
        "") bar_pins ler; fixados="$BAR_FIXADOS" ;;
        --lista|--list) modo=lista; bar_pins ler; fixados="$BAR_FIXADOS" ;;
        --instalados|--installed)
          awk -F'|' '$5 == 1 { print "app|applications:" $2 "|" $3 "|" $4 }' <<<"$tabela" | sort -f -t'|' -k3,3
          return 0 ;;
        --categorias|--categories)
          app_categories
          return 0 ;;
        --padrao|--padrão|--default)
          bar_pins padrao; fixados="$BAR_FIXADOS"
          ok "A barra voltou aos apps do começo." "The bar is back to the starting apps." ;;
        *) fail "Opção desconhecida: $1. Use --lista, --instalados, --categorias ou --padrao." "Unknown option: $1. Use --list, --installed, --categories or --default." ;;
      esac ;;
    fixar|pin)
      [[ $# -gt 0 ]] || fail "Diga qual app fixar. Exemplo: matsu barra fixar kate" "Say which app to pin. Example: matsu bar pin kate"
      for a in "$@"; do
        app="$(app_resolve "$a" "$tabela")" || fail "Não achei o app \"$a\"." "Could not find the app \"$a\"."
        apps+=("$app")
      done
      bar_pins fixar "${apps[@]}"; fixados="$BAR_FIXADOS"
      local fora=()
      for app in "${apps[@]}"; do
        if grep -qxF -- "$app" <<<"$BAR_NAO_COUBE"; then
          fora+=("$(pin_label "$app" "$tabela" | cut -d'|' -f1)")
        else
          ok "$(pin_label "$app" "$tabela" | cut -d'|' -f1) está na barra." "$(pin_label "$app" "$tabela" | cut -d'|' -f1) is on the bar."
        fi
      done
      if (( ${#fora[@]} )); then
        local cheia nomes
        cheia="$(bar_cheia_msg "$BAR_LIMITE")"
        nomes="$(IFS=,; printf '%s' "${fora[*]}")"; nomes="${nomes//,/, }"
        bar_avisar "$(t "$nomes não coube na barra" "$nomes did not fit on the bar")" "$cheia $(t "Para abrir lugar, tire um app da barra." "To make room, unpin an app.")"
        printf '%s✖%s %s\n' "$C_ERR" "$C_OFF" "$(t "$nomes não coube. $cheia" "$nomes did not fit. $cheia")" >&2
        tip "Para abrir lugar, tire um app: matsu barra tirar <app>" "To make room, unpin an app: matsu bar unpin <app>"
        exit 1
      fi ;;
    tirar|unpin|desafixar|remover)
      [[ $# -gt 0 ]] || fail "Diga qual app tirar. Exemplo: matsu barra tirar steam" "Say which app to unpin. Example: matsu bar unpin steam"
      bar_pins ler; fixados="$BAR_FIXADOS"
      for a in "$@"; do
        app="$(pin_match "$a" "$fixados" "$tabela")" || fail "\"$a\" não está fixado na barra." "\"$a\" is not pinned to the bar."
        apps+=("$app")
      done
      bar_pins tirar "${apps[@]}"; fixados="$BAR_FIXADOS"
      for app in "${apps[@]}"; do
        ok "$(pin_label "$app" "$tabela" | cut -d'|' -f1) saiu da barra." "$(pin_label "$app" "$tabela" | cut -d'|' -f1) left the bar."
      done ;;
    ordem|order)
      [[ $# -gt 0 ]] || fail "Diga a ordem. Exemplo: matsu barra ordem arquivos,navegador,steam" "Say the order. Example: matsu bar order files,browser,steam"
      bar_pins ler; fixados="$BAR_FIXADOS"
      # Aceita "a,b,c" ou "a b c" (e nomes com espaço entre vírgulas).
      local junto
      local -a pedidos=()
      junto="$(IFS=,; printf '%s' "$*")"
      IFS=',' read -r -a pedidos <<<"$junto"
      for a in "${pedidos[@]}"; do
        a="${a#"${a%%[![:space:]]*}"}"; a="${a%"${a##*[![:space:]]}"}"
        [[ -n $a ]] || continue
        app="$(pin_match "$a" "$fixados" "$tabela")" || fail "\"$a\" não está fixado na barra." "\"$a\" is not pinned to the bar."
        apps+=("$app")
      done
      bar_pins ordem "${apps[@]}"; fixados="$BAR_FIXADOS"
      ok "Ordem trocada." "Order changed." ;;
  esac
  if [[ $modo == lista ]]; then
    while IFS= read -r app; do
      [[ -n $app ]] || continue
      IFS='|' read -r nome icone desk < <(pin_label "$app" "$tabela")
      printf 'fixado|%s|%s|%s|%s\n' "$app" "$nome" "$icone" "$desk"
    done <<<"$fixados"
    # Quantos apps cabem na barra e o estilo (os Ajustes avisam quando enche).
    printf 'limite|%s|%s\n' "$BAR_LIMITE" "$(bar_saved estilo fusao)"
    return 0
  fi
  say "Apps fixados na barra:" "Apps pinned to the bar:"
  while IFS= read -r app; do
    [[ -n $app ]] || continue
    n=$((n + 1))
    IFS='|' read -r nome icone desk < <(pin_label "$app" "$tabela")
    case "$app" in
      preferred://browser)     nome+=" $(t "(navegador padrão)" "(default browser)")" ;;
      preferred://filemanager) nome+=" $(t "(arquivos padrão)" "(default file manager)")" ;;
    esac
    printf '  %2d. %s\n' "$n" "$nome"
  done <<<"$fixados"
  (( n )) || say "  (nenhum)" "  (none)"
  if (( BAR_LIMITE > 0 )); then
    if (( n >= BAR_LIMITE )); then
      tip "$(bar_cheia_msg "$BAR_LIMITE") Para fixar outro, tire um antes: matsu barra tirar <app>." \
          "$(bar_cheia_msg "$BAR_LIMITE") To pin another, unpin one first: matsu bar unpin <app>."
      return 0
    fi
    tip "Cabem até $BAR_LIMITE apps nesta barra." "Up to $BAR_LIMITE apps fit on this bar."
  fi
  tip "Para fixar outro: matsu barra fixar <app>. Para tirar: matsu barra tirar <app>." \
      "To pin another: matsu bar pin <app>. To unpin: matsu bar unpin <app>."
}

cmd_bar() {
  case "${1:-}" in
    apps|fixados|pinned|fixar|pin|tirar|unpin|desafixar|remover|ordem|order) cmd_bar_apps "$@"; return ;;
  esac
  local style="" size="" hide="" hide_top="" busca="" menu="" telas="" abertos="" details=0 novas=0 arg
  local amp="" nivel="" ind="" ani="" pos=""
  while [[ $# -gt 0 ]]; do
    arg="$1"; shift
    case "$arg" in
      --detalhes|--details) details=1 ;;
      fusao|fusão|fusion)   style=fusao ;;
      mac)                  style=mac ;;
      windows|win)          style=windows ;;
      --tamanho|--size)     size="${1:-}"; shift || true ;;
      --tamanho=*|--size=*) size="${arg#*=}" ;;
      --esconder|--autohide) hide="${1:-}"; shift || true ;;
      --esconder=*|--autohide=*) hide="${arg#*=}" ;;
      --esconder-topo|--autohide-top) hide_top="${1:-}"; shift || true ;;
      --esconder-topo=*|--autohide-top=*) hide_top="${arg#*=}" ;;
      --busca|--search)     busca="${1:-}"; shift || true ;;
      --busca=*|--search=*) busca="${arg#*=}" ;;
      --menu)               menu="${1:-}"; shift || true ;;
      --menu=*)             menu="${arg#*=}" ;;
      --telas|--screens)    telas="${1:-}"; shift || true ;;
      --telas=*|--screens=*) telas="${arg#*=}" ;;
      --abertos|--open-apps) abertos="${1:-}"; shift || true ;;
      --abertos=*|--open-apps=*) abertos="${arg#*=}" ;;
      # A doca do Matsu: ampliação ao passar o mouse (e quanto), pontinhos dos
      # apps abertos, pulo ao abrir (valem na hora, sem montar a barra de novo)
      # e, no estilo Mac, de que lado da tela a doca fica.
      --ampliacao|--magnification) amp="${1:-}"; shift || true ;;
      --ampliacao=*|--magnification=*) amp="${arg#*=}" ;;
      --ampliacao-nivel|--magnification-level) nivel="${1:-}"; shift || true ;;
      --ampliacao-nivel=*|--magnification-level=*) nivel="${arg#*=}" ;;
      --indicadores|--indicators) ind="${1:-}"; shift || true ;;
      --indicadores=*|--indicators=*) ind="${arg#*=}" ;;
      --animar|--animate) ani="${1:-}"; shift || true ;;
      --animar=*|--animate=*) ani="${arg#*=}" ;;
      --posicao|--position) pos="${1:-}"; shift || true ;;
      --posicao=*|--position=*) pos="${arg#*=}" ;;
      # Interno: uma tela foi ligada; põe a barra só nas telas sem nenhuma.
      --telas-novas|--new-screens) novas=1 ;;
      *) fail "Estilo desconhecido: $arg. Use fusao, mac ou windows." "Unknown style: $arg. Use fusao, mac or windows." ;;
    esac
  done
  case "$size" in
    "") ;;
    pequena|pequeno|small)     size=pequena ;;
    media|média|medio|medium)  size=media ;;
    grande|large|big)          size=grande ;;
    *)
      # Um número (a régua de tamanho da doca do Mac): de 1,8 a 4,2.
      if [[ "$(bar_scale "$size")" == "${size/,/.}" ]]; then
        size="${size/,/.}"
      else
        fail "Tamanho desconhecido: $size. Use pequena, media, grande ou um número de 1.8 a 4.2." \
             "Unknown size: $size. Use pequena, media, grande or a number from 1.8 to 4.2."
      fi ;;
  esac
  [[ -n $amp ]] && amp="$(bar_yes_no "$amp" --ampliacao)"
  [[ -n $ind ]] && ind="$(bar_yes_no "$ind" --indicadores)"
  [[ -n $ani ]] && ani="$(bar_yes_no "$ani" --animar)"
  if [[ -n $nivel && ! ( $nivel =~ ^[0-9]{1,3}$ && $nivel -le 100 ) ]]; then
    fail "Use --ampliacao-nivel de 0 a 100." "Use --magnification-level from 0 to 100."
  fi
  case "${pos,,}" in
    "") ;;
    embaixo|baixo|bottom)   pos=embaixo ;;
    esquerda|left)          pos=esquerda ;;
    direita|right)          pos=direita ;;
    *) fail "Use --posicao embaixo, esquerda ou direita." "Use --position embaixo, esquerda or direita." ;;
  esac
  if [[ -n $hide ]]; then
    hide="$(bar_hide_mode "$hide")" \
      || fail "Use --esconder nao, maximizado ou sempre." "Use --autohide nao, maximizado or sempre."
  fi
  if [[ -n $hide_top ]]; then
    hide_top="$(bar_hide_top_mode "$hide_top")" \
      || fail "Use --esconder-topo tela-cheia, maximizado ou sempre." "Use --autohide-top tela-cheia, maximizado or sempre."
  fi
  # Onde fica a pílula da busca (na fusão): junto do menu, na ilha do meio ou sem ela.
  case "${busca,,}" in
    "") ;;
    esquerda|junto|left|menu)   busca=esquerda ;;
    meio|centro|middle|center)  busca=meio ;;
    nao|não|nenhuma|sem|no|off|none) busca=nao ;;
    *) fail "Use --busca esquerda, meio ou nao." "Use --search esquerda, meio or nao." ;;
  esac
  # Onde fica o botão do menu (na fusão): na ilha da esquerda ou no meio, como no Windows 11.
  case "${menu,,}" in
    "") ;;
    esquerda|left)              menu=esquerda ;;
    meio|centro|middle|center)  menu=meio ;;
    *) fail "Use --menu esquerda ou meio." "Use --menu esquerda or meio." ;;
  esac
  # Com várias telas: a barra em todas (padrão) ou só na principal.
  case "${telas,,}" in
    "") ;;
    todas|all|sim|yes|on)               telas=todas ;;
    principal|main|uma|nao|não|no|off)  telas=principal ;;
    *) fail "Use --telas todas ou principal." "Use --screens todas or principal." ;;
  esac
  # Onde aparece cada app aberto: só na barra da tela dele (padrão), em todas
  # as barras, ou na principal e na da tela dele (as três opções do Windows).
  case "${abertos,,}" in
    "") ;;
    tela|screen|onde-esta)    abertos=tela ;;
    todas|all)                abertos=todas ;;
    principal|main)           abertos=principal ;;
    *) fail "Use --abertos tela, todas ou principal." "Use --open-apps tela, todas or principal." ;;
  esac

  local cur_style cur_size cur_hide cur_busca cur_menu cur_telas cur_abertos cur_amp cur_nivel cur_ind cur_ani cur_pos
  cur_amp="$(bar_saved ampliacao sim)"; cur_nivel="$(bar_saved ampliacao_nivel 50)"
  cur_ind="$(bar_saved indicadores sim)"; cur_ani="$(bar_saved animar sim)"; cur_pos="$(bar_saved posicao embaixo)"
  [[ $cur_amp == nao ]] || cur_amp=sim
  [[ $cur_nivel =~ ^[0-9]{1,3}$ ]] && (( cur_nivel <= 100 )) || cur_nivel=50
  [[ $cur_ind == nao ]] || cur_ind=sim
  [[ $cur_ani == nao ]] || cur_ani=sim
  [[ $cur_pos =~ ^(embaixo|esquerda|direita)$ ]] || cur_pos=embaixo
  local dock_changed=0
  if [[ ( -n $amp && $amp != "$cur_amp" ) || ( -n $nivel && $nivel != "$cur_nivel" ) || ( -n $ind && $ind != "$cur_ind" ) || ( -n $ani && $ani != "$cur_ani" ) ]]; then
    dock_changed=1
  fi
  amp="${amp:-$cur_amp}"; nivel="${nivel:-$cur_nivel}"; ind="${ind:-$cur_ind}"; ani="${ani:-$cur_ani}"
  cur_style="$(bar_saved estilo fusao)"
  cur_size="$(bar_saved tamanho media)"
  cur_hide="$(bar_hide_mode "$(bar_saved esconder nao)")" || cur_hide=nao
  local cur_hide_top
  cur_hide_top="$(bar_hide_top_mode "$(bar_saved esconder_topo tela-cheia)")" || cur_hide_top=tela-cheia
  cur_busca="$(bar_saved busca esquerda)"
  cur_menu="$(bar_saved menu esquerda)"
  cur_telas="$(bar_saved telas todas)"
  cur_abertos="$(bar_saved abertos tela)"
  hide="${hide:-$cur_hide}"
  hide_top="${hide_top:-$cur_hide_top}"
  export BAR_ESCONDER_TOPO="$hide_top"
  [[ $cur_busca =~ ^(esquerda|meio|nao)$ ]] || cur_busca=esquerda
  [[ $cur_menu =~ ^(esquerda|meio)$ ]] || cur_menu=esquerda
  [[ $cur_telas =~ ^(todas|principal)$ ]] || cur_telas=todas
  [[ $cur_abertos =~ ^(tela|todas|principal)$ ]] || cur_abertos=tela
  busca="${busca:-$cur_busca}"
  menu="${menu:-$cur_menu}"
  telas="${telas:-$cur_telas}"
  abertos="${abertos:-$cur_abertos}"

  if [[ $novas == 1 ]]; then
    bar_new_screens "${style:-$cur_style}" "${size:-$cur_size}" "$hide" "$busca" "$menu" "$telas" "$abertos"
    return
  fi

  local layout_same=0
  if [[ -z $style && -z $size && $busca == "$cur_busca" && $menu == "$cur_menu" \
        && $telas == "$cur_telas" && $abertos == "$cur_abertos" && ( -z $pos || $pos == "$cur_pos" ) ]]; then
    layout_same=1
  fi
  pos="${pos:-$cur_pos}"
  # Só o jeito de esconder mudou: vale na hora, nas barras que já estão na
  # tela, sem montar a barra de novo.
  if [[ $layout_same == 1 && ( $hide != "$cur_hide" || $hide_top != "$cur_hide_top" ) ]]; then
    bar_write_state "$cur_style" "$cur_size" "$hide" "$busca" "$menu" "$telas" "$abertos" "$amp" "$nivel" "$ind" "$ani" "$pos" "$hide_top"
    if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v busctl >/dev/null 2>&1 && [[ -r $BAR_DIR/esconder.js ]]; then
      bar_script "$(bar_vars "$cur_size" "$hide" "$busca" "$menu" "$telas" "$abertos" "$cur_style"; cat "$BAR_DIR/comum.js" "$BAR_DIR/esconder.js")" >/dev/null 2>&1 || true
    fi
    if [[ $dock_changed == 1 && -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v busctl >/dev/null 2>&1 && [[ -r $BAR_DIR/doca-ajustes.js ]]; then
      bar_script "$(bar_dock_vars; cat "$BAR_DIR/comum.js" "$BAR_DIR/doca-ajustes.js")" >/dev/null 2>&1 || true
    fi
    case "$hide" in
      maximizado) ok "A barra some com um app maximizado e volta quando o mouse encosta na borda." \
                     "The bar hides behind a maximized app and comes back when the mouse touches the edge." ;;
      sempre)     ok "A barra fica escondida e aparece quando o mouse encosta na borda." \
                     "The bar stays hidden and shows up when the mouse touches the edge." ;;
      *)          ok "A barra fica sempre na tela." "The bar always stays on screen." ;;
    esac
    return 0
  fi
  # Só os ajustes da doca mudaram: valem na hora, nas docas que já estão na
  # tela, sem montar a barra de novo.
  if [[ $layout_same == 1 && $dock_changed == 1 ]]; then
    bar_write_state "$cur_style" "$cur_size" "$hide" "$busca" "$menu" "$telas" "$abertos" "$amp" "$nivel" "$ind" "$ani" "$pos" "$hide_top"
    if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v busctl >/dev/null 2>&1 && [[ -r $BAR_DIR/doca-ajustes.js ]]; then
      bar_script "$(bar_dock_vars; cat "$BAR_DIR/comum.js" "$BAR_DIR/doca-ajustes.js")" >/dev/null 2>&1 || true
    fi
    ok "Doca ajustada." "Dock adjusted."
    return 0
  fi

  if [[ $layout_same == 1 ]]; then
    if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v kdialog >/dev/null 2>&1; then
      local on_f=off on_m=off on_w=off on_p=off on_d=off on_g=off
      case "$cur_style" in mac) on_m=on ;; windows) on_w=on ;; *) on_f=on ;; esac
      case "$cur_size" in pequena) on_p=on ;; grande) on_g=on ;; *) on_d=on ;; esac
      style="$(kdialog --title "Matsu" --radiolist "$(t "Como você quer a barra?" "How do you want the bar?")" \
        fusao   "$(t "Fusão: três ilhas flutuantes embaixo" "Fusion: three floating islands at the bottom")" "$on_f" \
        mac     "$(t "Mac: barra fina no topo e doca embaixo" "Mac: thin bar on top and a dock at the bottom")" "$on_m" \
        windows "$(t "Windows: uma barra só embaixo" "Windows: a single bar at the bottom")" "$on_w" | tr -d '"')" || return 0
      size="$(kdialog --title "Matsu" --radiolist "$(t "Qual o tamanho da barra?" "How big should the bar be?")" \
        pequena "$(t "Pequena" "Small")" "$on_p" \
        media   "$(t "Média" "Medium")" "$on_d" \
        grande  "$(t "Grande" "Large")" "$on_g" | tr -d '"')" || return 0
      [[ -z $style ]] && return 0
    else
      say "Estilo atual da barra: $cur_style, tamanho $cur_size." "Current bar style: $cur_style, size $cur_size."
      say "Busca: $cur_busca. Menu: $cur_menu." "Search: $cur_busca. Menu: $cur_menu."
      say "Telas: $cur_telas. Apps abertos: $cur_abertos." "Screens: $cur_telas. Open apps: $cur_abertos."
      say "Para trocar: matsu barra <fusao|mac|windows> [--tamanho pequena|media|grande] [--esconder nao|maximizado|sempre] [--busca esquerda|meio|nao] [--menu esquerda|meio] [--telas todas|principal] [--abertos tela|todas|principal]" \
          "To change: matsu bar <fusao|mac|windows> [--size pequena|media|grande] [--autohide nao|maximizado|sempre] [--search esquerda|meio|nao] [--menu esquerda|meio] [--screens todas|principal] [--open-apps tela|todas|principal]"
      return 0
    fi
  fi
  style="${style:-$cur_style}"
  size="${size:-$cur_size}"

  local f
  for f in trocar.js comum.js "$style.js" todas-as-telas.js; do
    [[ -r $BAR_DIR/$f ]] || fail "Não achei o arquivo do estilo: $BAR_DIR/$f" "Style file not found: $BAR_DIR/$f"
  done
  need busctl

  step "Trocando a barra para o estilo $style, tamanho $size" "Switching the bar to style $style, size $size"
  # 1) Tira as barras atuais. A área de trabalho responde com os apps fixados e
  #    as peças antigas.
  local reply1 reply2 linha fixados="" id
  if ! reply1="$(bar_script "$(cat "$BAR_DIR/comum.js" "$BAR_DIR/trocar.js")")"; then
    fail "Não consegui falar com a área de trabalho. Rode este comando dentro da sessão do Matsu." \
         "Could not reach the desktop. Run this command inside the Matsu session."
  fi
  # 2) Solta o atalho das peças antigas (Meta+A, Alt+F1, Meta+B, Meta+N), senão
  #    as peças novas não conseguem pegar os mesmos atalhos.
  while IFS= read -r linha; do
    case "$linha" in
      "matsu-fixado: "*)
        linha="${linha#matsu-fixado: }"; linha="${linha//\\/}"; linha="${linha//\"/}"
        fixados+="${fixados:+,}\"$linha\"" ;;
      "matsu-peca-velha: "*)
        id="${linha#matsu-peca-velha: }"
        if [[ $id =~ ^[0-9]+$ ]]; then
          busctl --user call org.kde.kglobalaccel /kglobalaccel org.kde.KGlobalAccel \
            unregister ss plasmashell "activate widget $id" >/dev/null 2>&1 || true
        fi ;;
    esac
  done < <(bar_reply_lines "$reply1")
  # 3) Monta o estilo novo com os apps que a pessoa tinha fixado, em cada tela.
  #    Os que não couberam numa barra menor ficaram guardados e voltam aqui
  #    (no fim da lista) quando a barra nova tem lugar: a doca do Mac.
  local guardados="$STATE_DIR/fixados-guardados" script
  if [[ $style == mac && -s $guardados ]]; then
    while IFS= read -r linha; do
      [[ -n $linha && $fixados != *"\"$linha\""* ]] || continue
      linha="${linha//\\/}"; linha="${linha//\"/}"
      fixados+="${fixados:+,}\"$linha\""
    done < "$guardados"
    rm -f "$guardados"
  fi
  local dock_vars
  dock_vars="$(printf 'var matsuAmpliacao = %s;\nvar matsuAmpliacaoNivel = %s;\nvar matsuIndicadores = %s;\nvar matsuAnimar = %s;\nvar matsuPosicao = "%s";\n' \
    "$([[ $amp == nao ]] && echo false || echo true)" "$nivel" "$([[ $ind == nao ]] && echo false || echo true)" \
    "$([[ $ani == nao ]] && echo false || echo true)" "$pos")"
  script="$(printf 'var matsuFixados = [%s];\n' "$fixados"
    bar_vars "$size" "$hide" "$busca" "$menu" "$telas" "$abertos" "$style"
    printf '%s\n' "$dock_vars"
    cat "$BAR_DIR/comum.js" "$BAR_DIR/$style.js" "$BAR_DIR/todas-as-telas.js")"
  if ! reply2="$(bar_script "$script")"; then
    fail "Não consegui falar com a área de trabalho. Rode este comando dentro da sessão do Matsu." \
         "Could not reach the desktop. Run this command inside the Matsu session."
  fi
  # --detalhes mostra o que a área de trabalho respondeu (ajuda a achar defeito).
  if [[ $details == 1 ]]; then bar_reply_lines "$reply1"; bar_reply_lines "$reply2"; fi
  bar_write_state "$style" "$size" "$hide" "$busca" "$menu" "$telas" "$abertos" "$amp" "$nivel" "$ind" "$ani" "$pos" "$hide_top"
  # A barra nova é menor que a de antes: os apps que passaram do limite ficam
  # guardados (e a pessoa fica sabendo quais).
  local cortados
  cortados="$(bar_reply_lines "$reply2" | sed -n 's/^matsu-cortado: //p')"
  if [[ -n $cortados ]]; then
    local tabela nomes="" app
    printf '%s\n' "$cortados" >> "$guardados"
    tabela="$(app_table)"
    while IFS= read -r app; do
      [[ -n $app ]] && nomes+="${nomes:+, }$(pin_label "$app" "$tabela" | cut -d'|' -f1)"
    done <<<"$cortados"
    ok "Barra trocada." "Bar changed."
    warn "Nem todos os apps fixados cabem nesta barra. Ficaram guardados: $nomes. Eles voltam no estilo Mac (a doca cabe mais)." \
         "Not every pinned app fits on this bar. Kept aside: $nomes. They come back in the Mac style (the dock fits more)."
    return 0
  fi
  ok "Barra trocada. Os apps que você fixou foram mantidos." "Bar changed. The apps you pinned were kept."
  tip "Para voltar ao padrão: matsu barra fusao --tamanho media --busca esquerda --menu esquerda" \
      "To go back to the default: matsu bar fusao --size media --search esquerda --menu esquerda"
}

# ---------------------------------------------------------------------------
# vidro / glass: a cor e a transparência das ilhas da barra e dos balões.
# A cor também vira a cor de destaque do sistema (botões ligados, seleção).
VIDRO_CORES=(padrao azul roxo rosa vermelho laranja amarelo verde grafite)
VIDRO_PADRAO_DESTAQUE="#6e6e76"   # o cinza neutro do Matsu (a seleção de MatsuEscuro e MatsuClaro)

# vidro_hex <nome ou #rrggbb>: a cor em #rrggbb ("" para o vidro sem cor).
vidro_hex() {
  case "${1,,}" in
    padrao|padrão|default|anil) printf '' ;;
    azul|blue)           printf '#2f80ed' ;;
    roxo|purple|violeta) printf '#8b5cf6' ;;
    rosa|pink)           printf '#ec4899' ;;
    vermelho|red)        printf '#ef4444' ;;
    laranja|orange)      printf '#f97316' ;;
    amarelo|yellow)      printf '#eab308' ;;
    verde|green)         printf '#22c55e' ;;
    grafite|graphite|cinza|gray|grey) printf '#6b7280' ;;
    \#[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) printf '%s' "${1,,}" ;;
    *) return 1 ;;
  esac
}

vidro_saved() { # vidro_saved <chave> <padrão>
  local v=""
  [[ -r $STATE_DIR/vidro ]] && v="$(sed -n "s/^$1=//p" "$STATE_DIR/vidro" | head -n1)"
  printf '%s' "${v:-$2}"
}

# O Plasma só relê o tema quando ele troca: passa pelo tema do KDE e volta.
vidro_recarregar() {
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}" atual
  rm -f "$cache"/plasma_theme_Matsu*.kcache "$cache"/plasma-svgelements-Matsu* 2>/dev/null
  command -v plasma-apply-desktoptheme >/dev/null 2>&1 || return 0
  atual="$(kreadconfig6 --file plasmarc --group Theme --key name 2>/dev/null)"
  if [[ $atual == Matsu ]]; then
    plasma-apply-desktoptheme default >/dev/null 2>&1 || true
    sleep "${MATSU_VIDRO_PAUSA:-1}"
  fi
  plasma-apply-desktoptheme Matsu >/dev/null 2>&1 || true
}

cmd_glass() {
  local cor="" nivel="" arg hex
  while [[ $# -gt 0 ]]; do
    arg="$1"; shift
    case "$arg" in
      --transparencia|--transparência|--transparency) nivel="${1:-}"; shift || true ;;
      --transparencia=*|--transparência=*|--transparency=*) nivel="${arg#*=}" ;;
      -*) fail "Opção desconhecida: $arg" "Unknown option: $arg" ;;
      *) cor="$arg" ;;
    esac
  done
  case "$nivel" in
    "") ;;
    mais|more|alta|high)         nivel=mais ;;
    normal|media|média|medium)   nivel=normal ;;
    menos|less|baixa|low)        nivel=menos ;;
    sem|nenhuma|none|off|solido|sólido|solid) nivel=sem ;;
    *) fail "Transparência desconhecida: $nivel. Use mais, normal, menos ou sem." "Unknown transparency: $nivel. Use mais, normal, menos or sem." ;;
  esac
  if [[ -n $cor ]]; then
    vidro_hex "$cor" >/dev/null || fail "Cor desconhecida: $cor. Use ${VIDRO_CORES[*]} ou #rrggbb." \
                                        "Unknown color: $cor. Use ${VIDRO_CORES[*]} or #rrggbb."
    case "${cor,,}" in \#*) cor="${cor,,}" ;; *) cor="$(vidro_nome "$cor")" ;; esac
  fi

  local cur_cor cur_nivel
  cur_cor="$(vidro_saved cor padrao)"
  cur_nivel="$(vidro_saved transparencia normal)"

  if [[ -z $cor && -z $nivel ]]; then
    if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v kdialog >/dev/null 2>&1; then
      local c on lista=()
      for c in "${VIDRO_CORES[@]}"; do
        on=off; [[ $c == "$cur_cor" ]] && on=on
        lista+=("$c" "$(vidro_rotulo "$c")" "$on")
      done
      cor="$(kdialog --title "Matsu" --radiolist "$(t "De que cor você quer o vidro?" "What color do you want the glass?")" "${lista[@]}" | tr -d '"')" || return 0
      local on_m=off on_n=off on_s=off on_x=off
      case "$cur_nivel" in mais) on_m=on ;; menos) on_s=on ;; sem) on_x=on ;; *) on_n=on ;; esac
      nivel="$(kdialog --title "Matsu" --radiolist "$(t "Quanto de transparência?" "How much transparency?")" \
        mais   "$(t "Mais transparente" "More transparent")" "$on_m" \
        normal "$(t "Normal" "Normal")" "$on_n" \
        menos  "$(t "Menos transparente" "Less transparent")" "$on_s" \
        sem    "$(t "Sem vidro (sólido)" "No glass (solid)")" "$on_x" | tr -d '"')" || return 0
      [[ -z $cor ]] && return 0
    else
      say "Vidro atual: cor $cur_cor, transparência $cur_nivel." "Current glass: color $cur_cor, transparency $cur_nivel."
      say "Para trocar: matsu vidro <${VIDRO_CORES[*]// /|}|#rrggbb> [--transparencia mais|normal|menos|sem]" \
          "To change: matsu glass <${VIDRO_CORES[*]// /|}|#rrggbb> [--transparency mais|normal|menos|sem]"
      return 0
    fi
  fi
  cor="${cor:-$cur_cor}"
  nivel="${nivel:-$cur_nivel}"
  hex="$(vidro_hex "$cor")"

  step "Trocando o vidro: cor $cor, transparência $nivel" "Changing the glass: color $cor, transparency $nivel"
  # O tema da pessoa só é apagado se foi o Matsu que fez (tem a marca).
  if [[ -d $VIDRO_DIR && ! -e $VIDRO_DIR/.matsu-vidro ]]; then
    fail "Já existe um tema seu em $VIDRO_DIR. Não vou mexer nele." "There is already a theme of yours in $VIDRO_DIR. Leaving it alone."
  fi
  rm -rf "$VIDRO_DIR"
  if [[ -n $hex || $nivel != normal ]]; then
    need python3
    [[ -r $VIDRO_GEN ]] || fail "Não achei o gerador do vidro: $VIDRO_GEN" "Glass generator not found: $VIDRO_GEN"
    mkdir -p "$VIDRO_DIR" && : > "$VIDRO_DIR/.matsu-vidro"
    if ! python3 "$VIDRO_GEN" ${hex:+--cor "$hex"} --transparencia "$nivel" "$VIDRO_DIR" >/dev/null; then
      rm -rf "$VIDRO_DIR"
      fail "Não consegui gerar o vidro." "Could not generate the glass."
    fi
  fi
  # A cor do destaque acompanha o vidro (no padrão, o cinza neutro do Matsu).
  if command -v plasma-apply-colorscheme >/dev/null 2>&1; then
    plasma-apply-colorscheme --accent-color "${hex:-$VIDRO_PADRAO_DESTAQUE}" >/dev/null 2>&1 \
      || warn "Não consegui trocar a cor de destaque." "Could not change the accent color."
  fi
  vidro_recarregar
  mkdir -p "$STATE_DIR" && printf 'cor=%s\ntransparencia=%s\n' "$cor" "$nivel" > "$STATE_DIR/vidro"
  ok "Vidro trocado." "Glass changed."
  tip "Para voltar ao padrão: matsu vidro padrao --transparencia normal" "To go back to the default: matsu glass padrao --transparency normal"
}

# Nome em português da cor (o que fica guardado e aparece na escolha).
vidro_nome() {
  case "${1,,}" in
    padrao|padrão|default|anil) echo padrao ;;
    azul|blue) echo azul ;;
    roxo|purple|violeta) echo roxo ;;
    rosa|pink) echo rosa ;;
    vermelho|red) echo vermelho ;;
    laranja|orange) echo laranja ;;
    amarelo|yellow) echo amarelo ;;
    verde|green) echo verde ;;
    *) echo grafite ;;
  esac
}

vidro_rotulo() {
  case "$1" in
    padrao)   t "Cinza neutro (padrão)" "Neutral gray (default)" ;;
    azul)     t "Azul" "Blue" ;;
    roxo)     t "Roxo" "Purple" ;;
    rosa)     t "Rosa" "Pink" ;;
    vermelho) t "Vermelho" "Red" ;;
    laranja)  t "Laranja" "Orange" ;;
    amarelo)  t "Amarelo" "Yellow" ;;
    verde)    t "Verde" "Green" ;;
    grafite)  t "Grafite" "Graphite" ;;
  esac
}

# O nome com a edição do ano ("Matsu 27 OS"), lido do próprio sistema.
system_name() {
  local nome=""
  if [[ -r ${MATSU_OS_RELEASE:-/etc/os-release} ]]; then
    nome="$(sed -n 's/^PRETTY_NAME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "${MATSU_OS_RELEASE:-/etc/os-release}")"
  fi
  printf '%s' "${nome:-Matsu OS}"
}

cmd_version() {
  local ref edicao
  printf '%s%s%s\n' "$C_BOLD" "$(system_name)" "$C_OFF"
  if [[ -r $IMAGE_INFO ]]; then
    edicao="$(info_field edicao)"
    if [[ -n $edicao && $edicao != null ]]; then
      say "  Edição:    20${edicao}" "  Edition:   20${edicao}"
    fi
    say "  Variante:  $(info_field image-variant)" "  Variant:   $(info_field image-variant)"
    say "  Montagem:  $(info_field build-id)" "  Build:     $(info_field build-id)"
  fi
  # Só mostra a imagem se der para ler sem senha: ver a versão nunca pede senha.
  ref="$(booted_ref_noroot)"
  if [[ -n $ref ]]; then say "  Imagem:    $ref" "  Image:     $ref"; fi
}

# ---------------------------------------------------------------------------
main() {
  local cmd="${1:-ajuda}"
  shift || true
  case "$cmd" in
    atualizar|update|upgrade)          cmd_update "$@" ;;
    voltar|rollback)                   cmd_rollback "$@" ;;
    drivers|driver)                    cmd_drivers "$@" ;;
    seguranca|segurança|security|kali) cmd_security "$@" ;;
    navegador|browser)                 cmd_browser "$@" ;;
    barra|bar|dock)                    cmd_bar "$@" ;;
    vidro|glass|cor|color)             cmd_glass "$@" ;;
    versao|versão|version|--version)   cmd_version ;;
    ajuda|help|-h|--help)              cmd_help ;;
    *)
      warn "Comando desconhecido: $cmd" "Unknown command: $cmd"
      cmd_help
      exit 2 ;;
  esac
}

main "$@"
